APP_NAME="Control Médico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://control_medico.test
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=control_medico
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Control Médico ---------------------------------------------------------
# Llave para buscar por CURP sin descifrarla. Genérala una sola vez con:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
BLIND_INDEX_KEY=
MEDICAL_FILES_DISK=local
MEDICAL_MAX_UPLOAD_KB=20480

# Usuarios iniciales (solo los usa el seeder). Si dejas la contraseña vacía,
# el seeder genera una aleatoria y la muestra en la terminal.
SEED_MEDICO_NAME="Dr. Nombre Apellido"
SEED_MEDICO_EMAIL=medico@consultorio.test
SEED_MEDICO_PASSWORD=
SEED_RECEPCION_NAME="Recepción"
SEED_RECEPCION_EMAIL=recepcion@consultorio.test
SEED_RECEPCION_PASSWORD=

# Recordatorios por WhatsApp (opcional, WhatsApp Business Cloud API de Meta).
# La plantilla debe estar aprobada y recibir 3 parámetros: nombre, fecha y hora.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Respaldos (config/backup.php). BACKUP_PATH debe estar fuera del equipo o
# sincronizada (OneDrive, Google Drive, disco externo). Guarda BACKUP_PASSWORD
# en un lugar seguro: sin ella no se pueden abrir los respaldos.
BACKUP_PATH=
BACKUP_PASSWORD=
BACKUP_KEEP_DAYS=30
BACKUP_TIME=21:30
BACKUP_MYSQLDUMP_PATH=mysqldump
